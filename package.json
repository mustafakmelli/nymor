{
  "name": "nymor",
  "version": "2.1.4",
  "description": "Sync your AI agent rules everywhere — one command, all agents",
  "keywords": [
    "ai",
    "agent",
    "rules",
    "claude",
    "cursor",
    "copilot",
    "kiro",
    "gemini",
    "windsurf",
    "skills",
    "cli",
    "sync"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mustafakmelli/nymor.git"
  },
  "bugs": {
    "url": "https://github.com/mustafakmelli/nymor/issues"
  },
  "homepage": "https://github.com/mustafakmelli/nymor#readme",
  "bin": {
    "nymor": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "check": "npm run build && npm test",
    "dev": "ts-node src/index.ts",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "commander": "^11.0.0",
    "fs-extra": "^11.0.0",
    "glob": "^10.0.0",
    "inquirer": "^9.0.0",
    "minimatch": "^10.2.5",
    "picocolors": "^1.0.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.0",
    "@types/inquirer": "^9.0.0",
    "@types/node": "^20.0.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.6.1"
  }
}
